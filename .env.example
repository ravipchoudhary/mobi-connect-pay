# Copy this file to .env on the VPS and fill in the values you need.

# ========================================
# ZOHO MAIL SMTP Configuration
# ========================================
# For OTP email delivery via Zoho Mail
# Get these from your Zoho Mail admin account

ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=your-zoho-email@zoho.com
ZOHO_SMTP_PASSWORD=your-zoho-smtp-password
ZOHO_FROM_EMAIL=your-zoho-email@zoho.com
ZOHO_FROM_NAME=Pay Solution

# ========================================
# Development Settings
# ========================================
# In development, set this to "true" to log emails instead of sending
# Emails will be logged to console and stored in memory
# For production, remove or set to "false"

ALLOW_DEV_EMAIL=true
ALLOW_DEV_OTP=true

# ========================================
# Environment
# ========================================
NODE_ENV=development
